# LLM backend: "openai" (default) or "local" (Ollama)
LLM_BACKEND=local
OPENAI_API_KEY=sk-...

# Vision backend: "openai" (GPT-4o) or "local" (Qwen2-VL via Ollama)
VISION_BACKEND=local

# Embedding backend: "openai" or "local" (BAAI/bge-m3)
EMBEDDING_BACKEND=local

# Redis (CHANGED)
REDIS_HOST=redis
REDIS_PORT=6379

# ChromaDB (CHANGED)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Databricks (optional)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=